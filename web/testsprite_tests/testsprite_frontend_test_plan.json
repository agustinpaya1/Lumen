        "type": "action",
        "description": "Navigate to /"
      },
      {
        "type": "action",
        "description": "Click on \"Enter Gallery\""
      },
      {
        "type": "assertion",
        "description": "Verify element \"initializing\" is visible"
      },
      {
        "type": "action",
        "description": "Wait for element \"Live Gallery\" to appear"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/home\""
      }
    ]
  },
