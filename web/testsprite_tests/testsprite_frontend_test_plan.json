  {
    "id": "TC010",
    "title": "Authenticated admin can open Admin view and see management controls",
    "description": "Verifies that an authenticated user can access the Admin view and see gallery management controls.",
    "category": "Admin View (Gallery Management)",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the email/username field"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the password field"
      },
      {
        "type": "action",
        "description": "Click the \"Log in\" button"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"home\""
      },
      {
        "type": "action",
        "description": "Click on the \"Admin\" link or menu item"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"admin\""
      },
      {
        "type": "assertion",
        "description": "Verify element \"Admin gallery list\" is visible"
      }
    ]
  },
