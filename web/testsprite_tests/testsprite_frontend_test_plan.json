    "id": "TC001",
    "title": "Splash screen renders branding and illustration on initial load",
    "description": "Verifies the onboarding splash screen loads and shows the expected event branding content before any navigation occurs.",
    "category": "Onboarding Splash Screen",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /"
      },
      {
        "type": "assertion",
        "description": "Verify element \"watercolor illustration\" is visible"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Enter Gallery\" is visible"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/\""
      }
    ]
  },
  {
    "id": "TC002",
    "title": "Manual entry navigates immediately to Home and cancels auto-timer behavior",
    "description": "Verifies clicking the manual entry button routes to Home without waiting for the full timer.",
    "category": "Onboarding Splash Screen",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Enter Gallery\" is visible"
      },
      {
        "type": "action",
        "description": "Click on \"Enter Gallery\""
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/home\""
      },
      {
        "type": "assertion",
        "description": "Verify element \"Live Gallery\" is visible"
      }
    ]
  },
  {
    "id": "TC003",
    "title": "Manual entry still succeeds when Device ID generation is slow (waits before routing)",
    "description": "Verifies that when initialization takes time, onboarding does not route until ready and then proceeds to Home once complete.",
    "category": "Onboarding Splash Screen",
    "priority": "Medium",
    "steps": [
