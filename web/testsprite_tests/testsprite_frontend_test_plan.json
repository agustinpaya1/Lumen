  {
    "id": "TC008",
    "title": "Delete owned photo with confirmation removes it from the gallery",
    "description": "Verifies deleting an owned photo via the modal confirmation removes it from the gallery view.",
    "category": "Live Shared Gallery (Home)",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /home"
      },
      {
        "type": "action",
