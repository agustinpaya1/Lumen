{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/web/browser",
  "routes": [
    {
      "src": "^/$",
      "has": [{ "type": "query", "key": "e", "value": "clausura-lideres-2026" }],
      "dest": "/clausura-lideres-2026.html"
    },
    { "handle": "filesystem" },
    {
      "src": "^/(?!api(?:/|$))(?!.*\\.(?:png|jpg|jpeg|gif|webp|svg|ico|css|js|woff|woff2|ttf|eot|json|map)$).*$",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/logs.ts": {
      "maxDuration": 30
    }
  }
}
