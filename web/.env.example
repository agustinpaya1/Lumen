# Server ONLY: Vercel project settings / local untracked .env.local.
# Never put these values in src/environments or frontend build substitutions.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
LOG_ALLOWED_ORIGINS=https://YOUR_PRODUCTION_DOMAIN
# Generate a random secret of at least 32 characters, e.g. openssl rand -hex 32.
LOG_IP_HASH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TELEGRAM_BOT_TOKEN=YOUR_BOTFATHER_TOKEN
TELEGRAM_CHAT_ID=YOUR_PRIVATE_CHAT_OR_GROUP_NUMERIC_ID
